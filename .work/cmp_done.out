
########## gang_icon.txt ##########
  src lines=100  dst lines=100
  --- SRC ---
   //这个配置文件每一次更新时，只能是在每一项的最后边加入新的，绝对不能修改以前的顺序或者索引
   //组合图标的文字字体
   [Font_Name]
   name1	= 字体一
   name2	= 字体二
   name3	= 字体三
   
  --- DST ---
   //This config file can only append new entries at the end of each section on update. Never modify previous order or indices.
   //Composite icon text fonts
   [Font_Name]
   name1	= Font 1
   name2	= Font 2
   name3	= Font 3
   

